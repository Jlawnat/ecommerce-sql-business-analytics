# Source data and generated databases
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Credentials and local configuration
.env
.env.*
!.env.example
kaggle.json
.kaggle/
secrets/

# Python/editor/test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
.idea/
.vscode/
.DS_Store
.taste-skill/

# Large/generated exports
*.zip
*.parquet
*.feather
reports/generated/
visualizations/generated/

# Next.js and Node generated files
web/node_modules/
web/.next/
web/out/
web/coverage/
web/.turbo/
web/.vercel/
web/tsconfig.tsbuildinfo
*.tsbuildinfo
web/.env*
!web/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
